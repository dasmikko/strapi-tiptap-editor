{
  "name": "strapi-tiptap-editor",
  "version": "2.0.0",
  "description": "A drop-in replacement for the strapi editor",
  "keywords": [
    "strapi",
    "tiptap",
    "editor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dasmikko/strapi-tiptap-editor.git"
  },
  "license": "MIT",
  "author": "dasmikko",
  "bugs": {
    "url": "https://github.com/dasmikko/strapi-tiptap-editor/issues"
  },
  "homepage": "https://github.com/dasmikko/strapi-tiptap-editor#readme",
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.js",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/src/index.js",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "prepare": "strapi-plugin build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-blockquote": "^3.32.1",
    "@tiptap/extension-bold": "^3.32.1",
    "@tiptap/extension-bubble-menu": "^3.32.1",
    "@tiptap/extension-code": "^3.32.1",
    "@tiptap/extension-code-block": "^3.32.1",
    "@tiptap/extension-document": "^3.32.1",
    "@tiptap/extension-hard-break": "^3.32.1",
    "@tiptap/extension-heading": "^3.32.1",
    "@tiptap/extension-highlight": "^3.32.1",
    "@tiptap/extension-horizontal-rule": "^3.32.1",
    "@tiptap/extension-image": "^3.32.1",
    "@tiptap/extension-italic": "^3.32.1",
    "@tiptap/extension-link": "^3.32.1",
    "@tiptap/extension-list": "^3.32.1",
    "@tiptap/extension-paragraph": "^3.32.1",
    "@tiptap/extension-strike": "^3.32.1",
    "@tiptap/extension-table": "^3.32.1",
    "@tiptap/extension-text": "^3.32.1",
    "@tiptap/extension-text-align": "^3.32.1",
    "@tiptap/extension-text-style": "^3.32.1",
    "@tiptap/extension-underline": "^3.32.1",
    "@tiptap/extension-youtube": "^3.32.1",
    "@tiptap/extensions": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/sdk-plugin": "^6.0.0",
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "strapi": {
    "name": "strapi-tiptap-editor",
    "displayName": "Strapi TipTap Editor",
    "description": "A drop-in replacement for the strapi editor",
    "kind": "plugin"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=6.0.0"
  }
}
